# ──────────────────────────────────────────────────────────────────────────
# PFJ backend environment — copy to ".env" and fill in real values.
# The real ".env" is gitignored and must NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────

# ── AI providers (optional) ────────────────────────────────────────────────
# If left blank, AI features fall back to high-quality built-in content.
# Groq is tried first, then Gemini.
GROQ_API_KEY=
GEMINI_API_KEY=

# GitHub token used to enrich resume/social analysis (optional, read-only scope).
GITHUB_TOKEN=

# ── Firebase Admin (required for auth + Firestore) ──────────────────────────
# Path to the service-account JSON file. Keep that file OUT of git.
FIREBASE_CREDENTIALS_PATH=config/firebase-service-account.json
# Realtime Database URL (used for quiz caching).
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.firebaseio.com
# Optional legacy Realtime DB secret. Prefer leaving blank and using the service account.
FIREBASE_DATABASE_SECRET=

# ── App security ────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (your frontend URL[s]). No wildcards in prod.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Runtime environment: "development" or "production".
# In "production", HTTPS redirect + HSTS are enforced.
ENV=development
